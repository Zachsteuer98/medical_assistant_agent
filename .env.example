# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Which corpus the API serves: "merck" (local only, licensed) or "public"
CORPUS=public

# docker compose only: host folder holding that corpus's index
# (./data/chroma_public for public, ./data/chroma for merck)
CHROMA_HOST_DIR=./data/chroma_public

# Comma-separated regexes for licence watermarks to strip during ingest
WATERMARK_PATTERNS=
